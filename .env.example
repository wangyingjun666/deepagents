# ============================================================
#  配置模板：复制成 .env 后填写自己的值
#    Windows:  copy .env.example .env
#    Linux/mac: cp .env.example .env
# ============================================================

# ---------- 大模型（OpenAI 兼容接口）----------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ---------- MySQL ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=company_db
MYSQL_POOL_SIZE=8
# 只读账号（建议建一个，配合 SQL 守卫形成数据库侧硬边界；留空则用上面的主账号）
MYSQL_RO_USER=
MYSQL_RO_PASSWORD=

# ---------- 联网搜索（可留空）----------
TAVILY_API_KEY=

# ---------- 知识库 RAGFlow（可留空）----------
RAGFLOW_API_URL=
RAGFLOW_API_KEY=

# ---------- 安全策略 ----------
# strict: 没有安全主体就拒绝受限操作；standard: 允许匿名；off: 关闭校验
SECURITY_MODE=strict
DEFAULT_ROLE=user
# SQL 守卫
SQL_MAX_ROWS=200
SQL_TIMEOUT_MS=5000
# 逗号分隔的表名白名单，留空表示不限制
SQL_ALLOWED_TABLES=
# 人工审批
APPROVAL_ENABLED=1
APPROVAL_TIMEOUT_SEC=120
MAX_APPROVAL_ROUNDS=5

# ---------- 沙箱 ----------
# auto: 有 Docker 用容器，没有则退回进程级；docker: 强制容器，不可用就启动失败；process: 强制进程级
SANDBOX_BACKEND=auto
SANDBOX_IMAGE=deep-search-sandbox:latest
# 1 = 容器内禁用网络（内核级）
SANDBOX_NETWORK=0
# 1 = 根文件系统只读
SANDBOX_READ_ONLY_ROOTFS=1
SANDBOX_CPUS=1
SANDBOX_MEMORY_MB=512
SANDBOX_PIDS_LIMIT=128
SANDBOX_TMPFS_MB=64
SANDBOX_EXEC_TIMEOUT_SEC=60
SANDBOX_RENDER_TIMEOUT_SEC=180
# 空闲多久回收容器
SANDBOX_IDLE_TTL_SEC=900
SANDBOX_MAX_CONCURRENT=4

# ---------- 并发闸门 ----------
MAX_CONCURRENT_SESSIONS=8
MAX_CONCURRENT_SUBAGENTS=3
MAX_CONCURRENT_LLM=8
MAX_CONCURRENT_TAVILY=4
MAX_CONCURRENT_RAGFLOW=4
MAX_CONCURRENT_MYSQL=8
# 排队超过这个时长就快速失败（毫秒）
SESSION_QUEUE_TIMEOUT_SEC=30

# ---------- Agent ----------
AGENT_RECURSION_LIMIT=40

# ---------- 落盘路径 ----------
CHECKPOINT_DB=logs/checkpoints.sqlite
TRACE_DIR=logs/trace
AUDIT_DIR=logs/audit

# ---------- 长期记忆（跨会话保留，MemoryMiddleware 每轮读进系统提示词） ----------
# 存的是 Markdown 文件（/memories/AGENTS.md），一个 SQLite 文件搞定，不需要额外服务。
# 记忆按 user_id 分命名空间，互不可见；删掉这个文件就等于清空所有长期记忆。
MEMORY_DB=logs/memory/memory.sqlite

# ---------- 结果反思（成文后核对任务要求是否覆盖完整） ----------
# 判为不充分时会带着缺口再跑一轮，轮数超上限就按当前结果交付。
# 反思环节自身出错一律按"充分"处理，不会因为反思挂了丢掉已经拿到的结果。
REFLECTION_ENABLED=1
REFLECTION_MAX_ROUNDS=2
# 留空复用 LLM_MODEL
REFLECTION_LLM_MODEL=

# ---------- 轨迹日志（模型看到什么、返回什么，供事后回放与分叉） ----------
TRAJECTORY_ENABLED=1
TRAJECTORY_DIR=logs/trajectory
# 单个字段的字符上限，0 表示不截断
TRAJECTORY_MAX_FIELD_CHARS=0
