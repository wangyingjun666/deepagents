# ============================================================
# DeepAgents 深度搜索系统 · 环境配置模板
# ============================================================
# 使用方法（把本文件复制一份并改名成 .env，再填入你的真实密钥）：
#   Windows（cmd / PowerShell）:
#       copy .env.example .env
#   macOS / Linux:
#       cp .env.example .env
#
# ！！重要！！：.env 里是真实密钥，永远不要提交到 GitHub。
# 本仓库的 .gitignore 已帮你忽略 .env，请放心。
# ------------------------------------------------------------

# ---------- 大模型（必填，任意 OpenAI 兼容接口都行） ----------
# 示例填写的是 DeepSeek，可换成 OpenAI / 通义 / 本地 vLLM 等。
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-换成你的Key
LLM_MODEL=deepseek-chat

# ---------- 联网搜索（可选） ----------
# 没有时“网络搜索”子智能体不可用，其余功能不受影响。
# 申请地址：https://app.tavily.com
TAVILY_API_KEY=tvly-换成你的Key

# ---------- RAGFlow 知识库（可选） ----------
# 需要你自己另外部署 RAGFlow 服务。不填则“知识库”子智能体不可用。
RAGFLOW_API_URL=
RAGFLOW_API_KEY=

# ---------- MySQL（数据库助手必填） ----------
# 请先启动本地 MySQL，并导入 sql/company_data.sql（见 README）。
MYSQL_USER=root
MYSQL_PASSWORD=换成你的MySQL密码
MYSQL_DATABASE=pharma_db
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
